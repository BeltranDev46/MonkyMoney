PORT=3001
NODE_ENV="development"

# URL pública del frontend (en producción: https://tu-app.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Orígenes permitidos por CORS (puedes separar varios con coma)
CORS_ORIGIN="http://localhost:5173"

# Cadena PostgreSQL (en Supabase usa Session Pooler o Transaction Pooler compatible con IPv4)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Credenciales de Supabase Auth (privadas en el backend)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="sb_publishable_..."

# Microservicio de Divisas (cuentasclaras-fx-microservice)
FX_SERVICE_URL="http://localhost:4001/api/v1"
FX_SERVICE_API_KEY="replace_with_a_strong_service_api_key"
